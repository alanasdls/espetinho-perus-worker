{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "espetinho-perus-api",
  "main": "worker.js",
  "compatibility_date": "2026-07-27",
  "workers_dev": true,
  "keep_vars": true,
  "kv_namespaces": [
    {
      "binding": "ORDERS_KV"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ORDER_REALTIME",
        "class_name": "OrderRealtime"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-realtime",
      "new_sqlite_classes": ["OrderRealtime"]
    }
  ]
}
